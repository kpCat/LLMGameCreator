{
  "schema_version": "0.1",
  "purpose": "Reference game profiles used to test whether the Capability Atlas is flexible enough for very different genres and runtime targets.",
  "content_overlays": [
    {
      "id": "content_overlay/optional_adult_nsfw/v1",
      "title": "Optional Adult/NSFW Layer",
      "summary": "Project-level optional layer for adult/NSFW themes when explicitly enabled by the creator. It must be tagged, filterable and export-aware. It is not a mandatory default for any profile.",
      "requires": ["content.rating_and_filters/v1"],
      "tags": ["optional_adult_content_aware", "mature_themes_optional"],
      "notes": "This overlay may apply to text, images, future animation requests, dialogue routes and scene metadata. It must stay separate from core mechanics so projects can enable, disable or filter it per export target."
    },
    {
      "id": "content_overlay/horror_gore_optional/v1",
      "title": "Optional Horror/Gore Layer",
      "summary": "Optional horror, gore and body-horror tags for projects that need them, with export/platform filtering.",
      "requires": ["content.rating_and_filters/v1"],
      "tags": ["horror_optional", "gore_optional"],
      "notes": "Separate from adult content; may combine with survival, dark fantasy or alien profiles."
    }
  ],
  "profiles": [
    {
