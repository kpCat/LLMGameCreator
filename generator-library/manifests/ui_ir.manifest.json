  "contracts": {
    "module_contract": "Every Lua module returns table, exposes manifest, validate_config(config), and generate(input, ctx).",
    "ui_ir_contract": "UI output is deterministic renderer-agnostic JSON-serializable IR/config, not a live renderer or Unity object graph.",
