{
  "id": "batch/010/quest_generation",
  "version": "0.1.0",
  "title": "Batch 010 — Quest/progress foundation",
  "category": "quest",
  "description": "Quest schema and compact quest generators for investigation, fetch, and location discovery flows.",
  "files": [
    "lua/quest/quest_schema.lua",
    "lua/quest/simple_investigation.lua",
    "lua/quest/fetch_quest.lua",
    "lua/quest/location_discovery.lua",
    "docs/lua/quest_generation.md",
    "manifests/quest_generation.manifest.json",
    "tests/quest_generation_examples.lua",
    "BATCH_010_REPORT.md"
  ],
  "modules": [
    {
      "id": "quest/quest_schema/v1",
      "path": "lua/quest/quest_schema.lua",
      "capabilities": [
        "quest.schema.normalize",
        "quest.progress.validate"
      ],
      "dependencies": [],
      "runtime_targets": ["debug", "unity2d", "unity3d"],
      "supported_turn_modes": ["realtime", "turn_based", "mixed", "paused_planning"],
      "supported_combat_modes": ["none", "realtime", "turn_based", "tactical", "dialogue_combat", "hybrid"]
    },
    {
      "id": "quest/simple_investigation/v1",
      "path": "lua/quest/simple_investigation.lua",
      "capabilities": [
        "quest.investigation.generate",
        "quest.from_dialogue",
        "quest.from_interaction"
      ],
      "dependencies": ["quest/quest_schema/v1"],
      "runtime_targets": ["debug", "unity2d", "unity3d"],
      "supported_turn_modes": ["realtime", "turn_based", "mixed"],
      "supported_combat_modes": ["none", "dialogue_combat", "hybrid"]
    },
    {
      "id": "quest/fetch_quest/v1",
      "path": "lua/quest/fetch_quest.lua",
      "capabilities": [
        "quest.fetch.generate",
        "quest.progress.abstract"
      ],
      "dependencies": ["quest/quest_schema/v1"],
      "runtime_targets": ["debug", "unity2d", "unity3d"],
      "supported_turn_modes": ["realtime", "turn_based", "mixed"],
      "supported_combat_modes": ["none", "realtime", "turn_based", "hybrid"]
    },
    {
      "id": "quest/location_discovery/v1",
      "path": "lua/quest/location_discovery.lua",
      "capabilities": [
        "quest.location_discovery.generate",
        "quest.from_interaction",
        "world.location.reveal"
      ],
      "dependencies": ["quest/quest_schema/v1"],
      "runtime_targets": ["debug", "unity2d", "unity3d"],
      "supported_turn_modes": ["realtime", "turn_based", "mixed"],
      "supported_combat_modes": ["none", "realtime", "turn_based", "hybrid"]
    }
  ],
  "capabilities": [
    "quest.schema.normalize",
    "quest.progress.validate",
    "quest.investigation.generate",
    "quest.fetch.generate",
    "quest.location_discovery.generate",
    "quest.from_dialogue",
    "quest.from_interaction",
    "quest.progress.abstract",
    "world.location.reveal"
  ],
  "contracts": {
    "quest_ir": "Quest table with id, title, status, start_stage_id, stages, triggers, progress_tracks, completion_conditions, effects, tags, and metadata.",
    "stage_ir": "Stage table with objectives, transitions, effects, and completion conditions.",
    "objective_ir": "Objective table with declarative type, target references, count/progress data, and completion conditions.",
    "condition_ir": "Declarative completion condition; evaluated by host runtime.",
    "effect_ir": "Declarative effect; applied by host runtime, not by generator modules."
  },
  "quality": {
    "lua_version": "5.4-compatible",
    "external_dependencies": false,
    "deterministic": true,
    "uses_file_system": false,
    "uses_network": false,
    "uses_math_random": false,
    "json_serializable_outputs": true
  }
}
