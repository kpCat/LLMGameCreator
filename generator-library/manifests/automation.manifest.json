  "contracts": {
    "module_contract": "Every Lua module returns table, exposes manifest, validate_config(config), and generate(input, ctx).",
    "automation_contract": "Automation outputs are compact deterministic IR/config metadata, not live runtime execution.",
    "recipe_contract": "Recipe graphs describe inputs, outputs, producers, consumers and production chain diagnostics.",
    "machine_contract": "Machine catalogs map recipe categories to machine profiles and power demand metadata.",
    "logistics_contract": "Conveyor grids describe logistics nodes and links as data, not belt physics.",
    "power_contract": "Power networks emit deterministic capacity/demand balance estimates and diagnostics."
